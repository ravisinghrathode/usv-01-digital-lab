# USV-01 Digital Engineering Lab — Environment Configuration Template
# Server runtime defaults
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Automatically provisioned in Google AI Studio / Cloud Run)
# GEMINI_API_KEY=

# Optional: Alternative Model Providers (The system defaults to Gemini or Deterministic Static Analysis)
# OPENAI_API_KEY=
# CHATGPT_MODEL=gpt-4o-mini

# Optional: Session Secret Override (Automatically generated with crypto.randomBytes(32) if unset)
# LAB_SESSION_SECRET=
