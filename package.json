{
  "name": "usv-01-digital-lab",
  "version": "1.0.0",
  "description": "NAVAL-USV | USV-01 25-Agent Digital Engineering Lab",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "chatgpt:verify": "tsx scripts/chatgpt-verify.ts",
    "governance:classify": "tsx scripts/governance/classify-change.ts",
    "governance:secrets": "tsx scripts/governance/secret-scanner.ts",
    "governance:validate": "tsx scripts/governance/validate-config.ts",
    "governance:ecr": "tsx scripts/governance/ecr-tool.ts",
    "governance:review": "tsx scripts/governance/independent-ai-review.ts",
    "governance:manifest": "tsx scripts/governance/release-manifest.ts",
    "prepare": "node -e \"const fs = require('fs'); try { fs.copyFileSync('scripts/pre-push.sh', '.git/hooks/pre-push'); fs.chmodSync('.git/hooks/pre-push', 0o755); } catch {}\" || true"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
