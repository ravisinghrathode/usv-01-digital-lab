        "status": { "type": "string", "enum": ["Draft", "Approved", "Executed", "Closed"] }
      },
      "required": ["id", "projectId", "title", "acceptanceCriteria"]
    },
    "test_records": {
      "title": "Test Record",
      "description": "Physical trial or lab execution evidence",
      "properties": {
        "id": { "type": "string" },
        "planId": { "type": "string" },
        "testDate": { "type": "string" },
        "executingEngineer": { "type": "string" },
