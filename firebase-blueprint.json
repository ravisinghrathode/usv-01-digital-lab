    "activity_log": {
      "title": "Activity Log",
      "description": "Immutable engineering audit trail",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "recordType": { "type": "string" },
        "recordId": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "action", "recordType"]
