{
  "name": "usv-01-digital-lab",
  "version": "1.0.0",
  "description": "Naval Design Studio | USV-01 governed engineering lab",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:ui": "vite",
    "dev:dockyard2": "vite --open /dockyard2.html",
    "dev:naval-design-studio": "vite --open /",
    "dev:naval-ai-lab": "vite --open /naval-lab.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=default --reporter=json --outputFile=governance/reports/test-results.json",
    "lint": "tsc --noEmit",
    "verify": "tsx scripts/verify-usv01.ts",
    "chatgpt:verify": "tsx scripts/chatgpt-verify.ts",
    "acceptance:campaign": "tsx scripts/run-acceptance-campaign.ts",
    "concept:research": "tsx scripts/run-concept-discovery.ts",
    "research:collect-public": "tsx scripts/collect-public-references.ts",
    "design:iterate": "tsx scripts/run-design-loop.ts",
    "design:live-cli": "tsx scripts/run-live-design-codex-cli.ts",
    "audit:capabilities": "tsx scripts/audit-capabilities.ts",
    "solver:submit": "tsx scripts/run-remote-solver-job.ts",
    "solver:gci": "tsx scripts/run-grid-convergence.ts",
    "benchmark:tools": "tsx scripts/run-tool-benchmarks.ts",
    "evidence:gate0": "tsx scripts/run-evidence-decision-gate.ts",
    "acceptance:accuracy": "tsx scripts/assess-agent-accuracy.ts",
    "acceptance:agt02-audit": "tsx scripts/run-agent-accuracy-audit.ts",
    "acceptance:numerical": "vitest run tests/independentNumericalOracles.test.ts",
    "acceptance:commission": "tsx scripts/run-commissioning-suite.ts",
    "acceptance:live-agents": "tsx scripts/run-live-agent-matrix.ts",
    "acceptance:codex-agents": "tsx scripts/run-codex-agent-campaign.ts",
    "acceptance:live-integrations": "tsx scripts/run-live-commissioning.ts",
    "governance:classify": "tsx scripts/governance/classify-change.ts",
    "governance:secrets": "tsx scripts/governance/secret-scanner.ts",
    "governance:validate": "tsx scripts/governance/validate-config.ts",
    "governance:ecr": "tsx scripts/governance/ecr-tool.ts",
    "governance:review": "tsx scripts/governance/independent-ai-review.ts",
    "governance:stage-d": "tsx scripts/governance/stage-d-human-approval.ts",
    "governance:stage-e": "tsx scripts/governance/stage-e-enforce.ts",
    "governance:keygen": "tsx scripts/governance/director-keygen.ts",
    "governance:sign": "tsx scripts/governance/sign-ecr.ts",
    "admin:provision-staff": "tsx scripts/admin/provision-staff-credential.ts",
    "governance:manifest": "tsx scripts/governance/release-manifest.ts",
    "prepare": "node -e \"const fs = require('fs'); try { fs.copyFileSync('scripts/pre-push.sh', '.git/hooks/pre-push'); fs.chmodSync('.git/hooks/pre-push', 0o755); } catch {}\" || true",
    "mission-control:test": "vitest run tests/subscriptionCliAdapter.test.ts tests/gitRevisionGuard.test.ts tests/missionControlCoordinator.test.ts tests/aiBillingPolicy.test.ts tests/quotaResilience.test.ts",
    "mission-control:preflight": "tsx scripts/mission-control/preflight.ts",
    "mission-control:a04-check": "tsx scripts/mission-control/a04-trusted-host-check.ts",
    "mission-control:pilot": "tsx scripts/mission-control/run-pilot.ts",
    "mission-control:docker:validate": "docker compose config --quiet",
    "acceptance:full-26": "tsx scripts/assess-engineering-campaign.ts",
    "mission-control:attest-host": "tsx scripts/mission-control/attest-codex-host.ts",
    "acceptance:sign-independent": "tsx scripts/engineering/sign-external-review.ts",
    "mission-control:quota": "tsx scripts/mission-control/resilient-queue.ts",
    "mission-control:quota:install-mac": "bash scripts/mission-control/install-quota-worker.sh",
    "a26:collect": "node scripts/a26/global-research.mjs collect",
    "a26:report": "node scripts/a26/global-research.mjs report",
    "a26:accept": "node scripts/a26/acceptance.mjs",
    "a26:test": "node --test tests/a26/*.test.mjs",
    "a26:unify": "node scripts/a26/unified-evidence.mjs",
    "a26:rules": "node scripts/a26/r3-policy-check.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
