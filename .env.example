# USV-01 Digital Engineering Lab — Environment Configuration Template
# Zero external API keys required: The system defaults to 100% offline deterministic execution.

# Server runtime defaults
PORT=3000
NODE_ENV=development

# Optional: Google Gemini API Key (Automatically provisioned in Google AI Studio / Cloud Run)
# If unset, the system runs with deterministic rules and local engineering calculators.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Session Secret Override (Automatically generated with crypto.randomBytes(32) if unset)
# LAB_SESSION_SECRET=
