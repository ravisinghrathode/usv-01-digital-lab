        "acceptanceCriteria": { "type": "string" },
        "owner": { "type": "string" },
        "revision": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "In Review", "Approved", "Superseded", "Archived"] },
        "relatedDecisions": { "type": "array", "items": { "type": "string" } },
        "relatedSimulations": { "type": "array", "items": { "type": "string" } },
        "relatedVerifications": { "type": "array", "items": { "type": "string" } },
