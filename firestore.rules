rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- AUTHENTICATION & LEAST-PRIVILEGE RBAC HELPERS ---
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isDirector() {
      return isAuthenticated() && (
        request.auth.token.role == 'ENGINEERING_DIRECTOR' ||
        request.auth.token.role == 'admin'
      );
    }

    function memberPath(projectId) {
      return /databases/$(database)/documents/project_members/$(projectId + '_' + request.auth.uid);
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && projectId is string && (
        isDirector() ||
        exists(memberPath(projectId))
      );
    }

    function isLeadOrAdmin(projectId) {
      return isAuthenticated() && (
        isDirector() ||
        (isProjectMember(projectId) &&
          get(memberPath(projectId)).data.role in ['lead_engineer', 'LEAD_SYSTEMS_ARCHITECT'])
      );
    }

    // Projects collection: Read by project members; modification restricted to leads/directors
    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow create: if isLeadOrAdmin(projectId);
      allow update: if isLeadOrAdmin(projectId);
      allow delete: if isDirector();
    }

    // Subsystems
    match /subsystems/{subsystemId} {
      allow read: if isAuthenticated() && isProjectMember(resource.data.projectId);
      allow create: if isLeadOrAdmin(request.resource.data.projectId);
      allow update: if isLeadOrAdmin(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isLeadOrAdmin(resource.data.projectId);
    }

    // Requirements register: Bound to project membership; Baseline modification requires lead/director
    match /requirements/{reqId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow create: if isAuthenticated() && isProjectMember(request.resource.data.projectId) &&
        (request.resource.data.status != 'Approved Baseline' || isLeadOrAdmin(request.resource.data.projectId));
      allow update: if isAuthenticated() && isProjectMember(resource.data.projectId) &&
        request.resource.data.projectId == resource.data.projectId &&
        (resource.data.status != 'Approved Baseline' && request.resource.data.status != 'Approved Baseline' ||
        isLeadOrAdmin(resource.data.projectId));
      allow delete: if isLeadOrAdmin(resource.data.projectId);
    }

    // Interfaces / ICDs
    match /interfaces/{interfaceId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isProjectMember(request.resource.data.projectId);
    }

    // Design Decisions: Formal baseline decisions require lead or director approval
    match /design_decisions/{decisionId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow create: if isAuthenticated() && isProjectMember(request.resource.data.projectId) &&
        (request.resource.data.status != 'Approved' || isLeadOrAdmin(request.resource.data.projectId));
      allow update: if isAuthenticated() && isProjectMember(resource.data.projectId) &&
        request.resource.data.projectId == resource.data.projectId &&
        (resource.data.status != 'Approved' && request.resource.data.status != 'Approved' ||
        isLeadOrAdmin(resource.data.projectId));
      allow delete: if isDirector();
    }

    // Engineering Risks
    match /engineering_risks/{riskId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isProjectMember(request.resource.data.projectId);
    }

    // Simulation Jobs
    match /simulation_jobs/{jobId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isProjectMember(request.resource.data.projectId);
    }

    // Verification Plans & Test Records
    match /verification_plans/{planId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isProjectMember(request.resource.data.projectId);
    }

    match /test_records/{recordId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isProjectMember(request.resource.data.projectId);
    }

    // Components & Bill of Materials
    match /components/{componentId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isProjectMember(request.resource.data.projectId);
    }

    // Controlled Documents
    match /documents/{docId} {
      allow read: if isAuthenticated() && (resource == null || isProjectMember(resource.data.projectId));
      allow write: if isAuthenticated() && isLeadOrAdmin(request.resource.data.projectId);
    }

    // Human Authority Safety Approval Gates: Final decision strictly restricted to ENGINEERING_DIRECTOR
    match /approval_gates/{gateId} {
      allow read: if isAuthenticated();
      allow create: if isLeadOrAdmin(request.resource.data.projectId);
      allow update: if isDirector();
      allow delete: if false; // Immutable safety ledger
    }

    // Activity Log - append only, immutable
    match /activity_log/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isDirector());
      allow update, delete: if false;
    }

    // Users and Project Members
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isDirector());
    }

    match /project_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isDirector();
    }
  }
}
