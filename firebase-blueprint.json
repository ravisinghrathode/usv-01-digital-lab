      "title": "Verification Plan",
      "description": "Testing and validation procedure",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "subsystemCode": { "type": "string" },
        "title": { "type": "string" },
        "procedure": { "type": "string" },
        "acceptanceCriteria": { "type": "string" },
        "instrumentation": { "type": "string" },
