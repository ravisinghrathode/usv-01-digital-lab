# USV-01 Digital Engineering Lab — Environment Configuration Template
# Default policy: zero paid AI API usage.

# Server runtime defaults
PORT=3000
NODE_ENV=development

# Paid AI API access is denied unless explicitly enabled.
# Keep this FALSE for the project configuration discussed with the Project Lead.
USV_ALLOW_PAID_AI_API=false

# Subscription-only Mission Control is separately opt-in on the local Mac.
# Enable only after Claude Code, Antigravity CLI, and Codex CLI are installed
# and signed in with the intended user subscriptions/accounts.
USV_SUBSCRIPTION_PILOT=disabled

# Existing API-backed integrations are retained for compatibility but remain
# unusable while USV_ALLOW_PAID_AI_API=false.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=

# Optional: Session Secret Override (Automatically generated with crypto.randomBytes(32) if unset)
# LAB_SESSION_SECRET=

# Required to bootstrap initial staff identity via /api/auth/provision-initial.
# Generate a random 32+ character secret, store it outside Git, and disable/remove after bootstrap.
# INITIAL_PROVISION_SECRET=
# Persistent credential store path; ensure filesystem permissions restrict access.
# STAFF_CREDENTIAL_STORE=
