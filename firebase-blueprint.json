{
  "entities": {
    "projects": {
      "title": "Project",
      "description": "USV project configuration and global metadata",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Paused", "Archived"] },
        "governanceState": { "type": "string" },
        "leadEngineer": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "status"]
    },
    "subsystems": {
