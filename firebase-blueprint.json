    "engineering_risks": {
      "title": "Engineering Risk",
      "description": "Technical and project risk tracking",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "subsystemCode": { "type": "string" },
        "description": { "type": "string" },
        "probability": { "type": "number" },
